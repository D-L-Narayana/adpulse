{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=adpulse.db"
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "https://adpulse-dashboard-nu.vercel.app"
    ]
  },
  "RateLimiting": {
    "SignupPerMinute": 20
  },
  "Pacing": {
    "Enabled": true,
    "EvaluationInterval": "1.00:00:00",
    "InitialDelay": "00:01:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogstashTcp": "",
    "FilePath": ""
  },
  "AllowedHosts": "*"
}
